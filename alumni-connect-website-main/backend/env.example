# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/alumnex-connect

# Redis Configuration (Required for caching and WebSockets scaling)
REDIS_URL=redis://127.0.0.1:6379

# JWT Configuration
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (for notifications & weekly digest)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_KEY=your-brevo-smtp-key-xsmtpsib
WEEKLY_DIGEST_CRON="0 10 * * 1"

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Judge0 API (for coding contests)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google OAuth (Shared default client for Google Login and Calendar)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
MOBILE_GOOGLE_REDIRECT_URI=https://alumnex-backend-2.onrender.com/api/auth/mobile/google/callback

# Google Calendar Integration (OAuth 2.0 Incremental Authorization)
# Optional dedicated client override (falls back to GOOGLE_CLIENT_ID / SECRET if omitted):
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://alumnex-backend-2.onrender.com/api/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://alumnex-backend-2.onrender.com/api/google-calendar/webhook
GOOGLE_CALENDAR_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_HEX_OR_BASE64_KEY

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub Mobile OAuth (Capacitor app)
GITHUB_MOBILE_CLIENT_ID=your-mobile-github-client-id
GITHUB_MOBILE_CLIENT_SECRET=your-mobile-github-client-secret

GITHUB_TOKEN=

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Groq API
GROQ_API_KEY=your-groq-api-key

# Fast2SMS API Key for OTP SMS
FAST2SMS_API_KEY=your-fast2sms-api-key

# ─── Activity Hub Configuration ───────────────────────────────
# Controls whether the activity reminder cron runs
ACTIVITY_CHECK_ENABLED=true

# Cron schedule for daily reminders (default: every 2 hours)
ACTIVITY_REMINDER_CRON="0 */2 * * *"

# Cron schedule for weekly activity summaries (default: Sunday 10 AM)
ACTIVITY_WEEKLY_CRON="0 10 * * 0"

# Default timezone for reminders (users can override individually)
REMINDER_TIMEZONE=Asia/Kolkata

# ─── Web Push & FCM Multi-Channel Notifications ──────────────────
# Web Push VAPID Keys (Generate with npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@alumnex.com

# Firebase Cloud Messaging (Android APK Push via Firebase Admin SDK)
# Option 1: Standard Render environment variables (Recommended)
FIREBASE_PROJECT_ID=alumnex-connect
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@alumnex-connect.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIB...-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON string in environment variable
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
