# Frontend Environment Variables

# Use this URL to connect to the backend API locally
REACT_APP_API_URL=http://localhost:5000/api

# For production on Render.com, set this in your Render Dashboard to:
# REACT_APP_API_URL=https://<your-backend-app-name>.onrender.com/api

# Disable source-map generation in production builds to prevent code exposure
GENERATE_SOURCEMAP=false
